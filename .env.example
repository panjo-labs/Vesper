OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Optional overrides
# GEMMA_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free
# Must be a premade voice on the free plan; library voices return 402.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Run Gemma on your own machine with Ollama instead of OpenRouter.
# Then OPENROUTER_API_KEY is not needed and your material stays local.
# GEMMA_LOCAL_URL=http://localhost:11434/v1/chat/completions
# GEMMA_MODELS=gemma4:e4b

# Ambient beds need the sound_generation permission on the ElevenLabs key.
# They are generated once per mood and cached in .cache/ambient.
